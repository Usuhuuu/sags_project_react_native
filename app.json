{
  "expo": {
    "name": "sags_project",
    "slug": "sags_project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sags_project",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.usuhbayr.sags_project",
      "config": {
        "googleMapsApiKey": "YOUR_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow access to location to show nearby places.",
        "NSCameraUsageDescription": "Allow access to the camera.",
        "NSMicrophoneUsageDescription": "Allow access to the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.usuhbayr.client"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "zaalproject"
        }
      ],
      "expo-build-properties",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "dba4003f-454c-4ea3-af94-4328a2d590ac"
      }
    },
    "owner": "usuhbayr"
  }
}
